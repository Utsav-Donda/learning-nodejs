# Copy this file to .env and fill in real values. .env itself is
# gitignored — only .env.example (with placeholder values) is committed,
# so secrets never end up in version control.
#
# Note: config.js's validation only rejects a MISSING API_KEY, not an
# obviously-fake one — so copying this file as-is will boot the server
# without triggering that check. To see the fail-fast validation in
# action, run the server WITHOUT a .env file at all (see the topic
# README) instead of relying on this placeholder to trip it.
PORT=3000
NODE_ENV=development
API_KEY=replace-with-a-real-key
